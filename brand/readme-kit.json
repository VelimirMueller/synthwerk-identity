    {
      "key": "lead",
      "type": "lead",
      "title": "ABOUT",
      "text": "**synthwerk-identity** owns organisations, roles, entitlements and the paywall for the synthwerk services. Zitadel says who you are. This service decides what that is worth."
    },
    {
      "key": "what",
      "type": "notes",
      "title": "THE SHORT VERSION",
      "columns": 2,
      "items": [
        {
          "lead": "Owns the model",
          "text": "Owns organisations, roles and entitlements for every synthwerk service."
        },
        {
          "lead": "Login by Zitadel v4",
          "text": "OIDC, passkeys, MFA. No login form lives here."
        },
        {
          "lead": "Stripe in, entitlements out",
          "text": "Turns Stripe events into one entitlements table. The paywall reads that table."
        },
        {
          "lead": "Identity events",
          "text": "Emits identity events on the NATS bus. The other services trust them."
        }
      ]
    },
    {
      "key": "startnotes",
      "type": "notes",
      "title": "WHAT YOU GET",
      "columns": 3,
      "items": [
        {
          "lead": "Go on main",
          "text": "`main` holds the Go service: orgs, members, roles and the Zitadel user hook."
        },
        {
          "lead": "Needs Postgres",
          "text": "`SYNTHWERK_IDENTITY_DATABASE_URL` is required. Migrations apply at startup."
        },
        {
          "lead": "Epic E2 Identity",
          "text": "The rewrite is epic **E2 Identity** on the [synthwerk map](https://github.com/VelimirMueller/synthwerk). It is in progress."
        }
      ]
    },
    {
      "key": "calls",
      "type": "cards",
      "title": "IDENTITY TALKS TO THREE THINGS",
      "items": [
        {
          "title": "ZITADEL V4",
          "text": "The login: OIDC, passkeys, MFA."
        },
        {
          "title": "POSTGRES",
          "text": "Orgs, roles, entitlements."
        },
        {
          "title": "NATS BUS",
          "text": "Identity events for the other services."
        }
      ]
    },
    {
      "key": "paywall",
      "type": "flow",
      "title": "THE PAYWALL",
      "nodes": [
        {
          "title": "STRIPE EVENTS",
          "sub": "Payments come in as webhooks."
        },
        {
          "title": "ENTITLEMENTS",
          "sub": "One table, owned here.",
          "hot": true
        },
        {
          "title": "THE PAYWALL",
          "sub": "Reads that table."
        }
      ]
    },
    {
      "key": "hownotes",
